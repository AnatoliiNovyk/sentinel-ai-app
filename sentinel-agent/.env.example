# ─── Required ────────────────────────────────────────────────────────────────
# Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=https://ysnlccidbtqqburuflkz.supabase.co

# Service role key — KEEP SECRET, never commit (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# Anon/public key (Settings → API → anon public)
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Shared secret between agent and frontend (generate: openssl rand -hex 32)
AGENT_SECRET=generate-a-strong-random-secret-here

# ─── Optional — SLO thresholds (milliseconds) ─────────────────────────────────
SLO_CLAIM_AVG_MS_THRESHOLD=2000
SLO_EXECUTE_AVG_MS_THRESHOLD=120000
SLO_REPORT_AVG_MS_THRESHOLD=15000
SLO_END_TO_END_AVG_MS_THRESHOLD=180000
SLO_MIN_SAMPLE_COUNT=5
SLO_ALERT_COOLDOWN_MS=900000

# ─── Optional — Stale job watchdog ────────────────────────────────────────────
STALE_RUNNING_JOB_TIMEOUT_MINUTES=180
STALE_WATCHDOG_INTERVAL_MS=60000
PROWLER_TIMEOUT_MS=1200000

# ─── Optional — AWS credentials for Prowler cloud security scanning ──────────
# Leave empty to disable Prowler (scan will return an info finding instead of failing)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ─── Optional — Operational alerts ───────────────────────────────────────────
# Slack/Discord/Teams webhook URL for SLO breach alerts (leave empty to disable)
OPERATIONAL_ALERT_WEBHOOK_URL=

# ─── Optional — OpenTelemetry distributed tracing ────────────────────────────
# Set OTEL_ENABLED=true to activate tracing. Requires an OTLP-compatible backend
# (Jaeger, Tempo, Honeycomb, Grafana Cloud Traces, etc.)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=sentinel-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─── Optional — Log retention (GDPR/SOC2) ────────────────────────────────────
# Logs older than LOG_RETENTION_DAYS are deleted automatically (default: 90 days)
LOG_RETENTION_DAYS=90
LOG_CLEANUP_INTERVAL_MS=86400000

# ─── Optional — Health & metrics server ──────────────────────────────────────
# Port for /health (JSON) and /metrics (Prometheus) endpoints
HEALTH_PORT=9090

# ─── Optional — Parallel job dispatch ────────────────────────────────────────
# Maximum concurrent scan jobs (default: 2). Increase with caution — Prowler
# uses ~2.8 GB RAM. Recommended max on 4 GB VPS: 2
AGENT_MAX_CONCURRENT_JOBS=2
