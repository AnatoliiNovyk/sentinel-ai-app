{
  "name": "sentinel-ai-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:no-js-duplicates": "node scripts/check-no-ts-js-duplicates.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "node scripts/warn-safe-tests.cjs && vitest",
    "test:run": "node scripts/warn-safe-tests.cjs && vitest run",
    "test:targeted:stability": "vitest run src/pages/__tests__/Dashboard.test.tsx src/pages/__tests__/Chat.integration.test.tsx src/pages/__tests__/Scans.integration.test.tsx --pool=forks --poolOptions.forks.maxForks=1 --poolOptions.forks.minForks=1",
    "test:full:stability": "vitest run --pool=forks --poolOptions.forks.maxForks=1 --poolOptions.forks.minForks=1",
    "test:dashboard:stable": "node --max-old-space-size=6144 ./node_modules/vitest/vitest.mjs run src/pages/__tests__/Dashboard.test.tsx --pool=forks --poolOptions.forks.maxForks=1 --poolOptions.forks.minForks=1",
    "test:trio:stable": "node --max-old-space-size=6144 ./node_modules/vitest/vitest.mjs run src/pages/__tests__/Dashboard.test.tsx src/pages/__tests__/Projects.test.tsx src/pages/__tests__/Reports.test.tsx --pool=forks --poolOptions.forks.maxForks=1 --poolOptions.forks.minForks=1",
    "test:full:stability:heap": "node --max-old-space-size=6144 ./node_modules/vitest/vitest.mjs run --pool=forks --poolOptions.forks.maxForks=1 --poolOptions.forks.minForks=1",
    "test:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-safe.ps1",
    "test:safe:dashboard": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-safe.ps1 -Suite dashboard",
    "test:safe:trio": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-safe.ps1 -Suite trio",
    "test:safe:full": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-safe.ps1 -Suite full",
    "test:ops:contracts": "node scripts/test-ops-scripts.cjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ui": "vitest --ui",
    "browserslist:update-db": "npx update-browserslist-db@latest --yes",
    "quality:check": "npm run check:no-js-duplicates && npm run lint -- --max-warnings=0 && npm run typecheck && npm run test:run && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.0",
    "dompurify": "^3.4.1",
    "lucide-react": "^0.344.0",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.18",
    "brace-expansion": "^5.0.5",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.59.1",
    "vite": "^5.4.2",
    "vitest": "^2.1.8"
  }
}
